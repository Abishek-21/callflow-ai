# Copy this file to .env and fill in values. Never commit .env.

# --- LLM evaluation (optional) -------------------------------------------
# Leave OPENAI_API_KEY blank to run in mock-evaluation mode (no API calls).
# Uses the official OpenAI Python SDK, so any OpenAI-compatible provider works.
#
# OpenAI:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=
#   OPENAI_MODEL=gpt-4o-mini
#
# xAI Grok:
#   OPENAI_API_KEY=xai-...
#   OPENAI_BASE_URL=https://api.x.ai/v1
#   OPENAI_MODEL=<a Grok model id from https://docs.x.ai/docs/models>
#
# Groq (keys start with gsk_; free tier available):
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# --- App -------------------------------------------------------------------
# SQLite database location.
DATABASE_URL=sqlite:///./callflow.db

# Load 18 fictional demo calls on startup when the database is empty
# (or run `python -m scripts.seed_demo` yourself). Set to false to start empty.
SEED_DEMO_DATA=true

# Where the Streamlit frontend finds the FastAPI backend.
API_BASE_URL=http://localhost:8000
